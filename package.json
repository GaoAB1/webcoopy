{
  "name": "webcopy",
  "version": "0.1.0",
  "description": "Fetch a URL and convert the article body to faithful Markdown (CLI tool).",
  "type": "module",
  "bin": {
    "webcopy": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "fix:lock": "node scripts/patch-lock-optional-deps.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "http-proxy-agent": "^9.1.0",
    "iconv-lite": "^0.7.3",
    "jsdom": "^25.0.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/iconv-lite": "^0.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/turndown": "^5.0.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "markdown",
    "web",
    "scraper",
    "cli",
    "readability"
  ],
  "license": "MIT"
}
